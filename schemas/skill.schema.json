{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/schemas/skill.schema.json",
  "title": "Skill manifest",
  "type": "object",
  "required": ["schema", "id", "version", "name", "description", "entry", "resources"],
  "properties": {
    "schema": {
      "const": "skill/v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9-]+/[a-z0-9-]+$"
    },
    "version": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "entry": {
      "type": "string"
    },
    "compatibility": {
      "type": "object",
      "properties": {
        "agents": {
          "type": "array",
          "minItems": 1,
          "items": {
            "enum": ["codex", "enlighten-ai"]
          },
          "uniqueItems": true
        }
      }
    },
    "resources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
